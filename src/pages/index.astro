---
import Base from "../layouts/Base.astro";
import Nav from "../components/Nav.svelte";
import Hero from "../components/Hero.astro";
import About from "../components/About.astro";
import Projects from "../components/Projects.astro";
import Skills from "../components/Skills.astro";
import Contact from "../components/Contact.astro";
import Doodles from "../components/Doodles.astro";
import "../styles/global.css";
---

<Base>
	<Nav client:load />

	<main id="main">
		<Hero />
		<About />
		<Projects />
		<Skills />
		<Contact />
	</main>

	<footer class="shell footer">
		<p>
			Built with Astro and Tailwind. Served from the edge — no origin, no runtime.
		</p>
		<p class="footer__mark">
			<Doodles name="circle" accent="iris" size={26} rotate={-10} />
		</p>
	</footer>
</Base>

<style>
	.footer {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 3rem 4rem;
		margin-block-start: 2rem;
		border-block-start: 1px solid var(--color-highlight-low);
		color: var(--color-muted);
		font-family: var(--font-mono);
		font-size: 0.8125rem;
	}

	.footer__mark {
		display: grid;
		place-items: center;
		opacity: 0.6;
	}
</style>
