---
import Doodles from "./Doodles.astro";
import { AREAS, LEARNING } from "../data/site";
---

<section id="about" class="section">
	<div class="shell">
		<p class="eyebrow">About</p>
		<h2 class="section__title">The short version</h2>

		<div class="about">
			<div class="about__prose">
				<p class="about__lead">
					I prefer understanding the low level before trusting the high level.
				</p>
				<p>
					The stack behind this site is deliberately boring. The constraint of having
					no public address to hide behind is what taught me the most — every
					service has to justify its own exposure, and none of them have any.
				</p>
				<p>
					I'm early in this, and I'd rather be honest about that than pad a résumé.
					What I can do is take a system end to end, work out why it broke, and write
					down what I changed so the next failure is cheaper than the last one.
				</p>
			</div>

			<aside class="note" aria-labelledby="learning-heading">
				<div class="note__doodle" aria-hidden="true">
					<Doodles name="spark" accent="gold" size={80} rotate={-6} />
				</div>
				<h3 id="learning-heading" class="eyebrow">Currently learning</h3>
				<ul class="note__list" role="list">
					{
						LEARNING.map((item) => (
							<li class="note__item">
								<span class="note__bullet" aria-hidden="true" />
								{item}
							</li>
						))
					}
				</ul>
			</aside>
		</div>

		<ul class="areas" role="list">
			{
				AREAS.map((area, i) => (
					<li
						class="panel areas__item animate-enter"
						style={`--stagger: ${i}`}
					>
						<span
							class="areas__rule"
							style={`background-color: var(--color-${area.accent})`}
							aria-hidden="true"
						/>
						<h3 class="areas__title">{area.title}</h3>
						<p class="areas__body">{area.body}</p>
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.about {
		display: grid;
		gap: 2rem;
		margin-block: 2.5rem 3.5rem;
	}

	.about__prose {
		display: grid;
		gap: 1.25rem;
		max-inline-size: 62ch;
		color: var(--color-subtle);
	}

	.about__lead {
		font-family: var(--font-display);
		font-size: clamp(1.25rem, 3vw, 1.625rem);
		font-weight: 500;
		line-height: 1.3;
		letter-spacing: -0.02em;
		color: var(--color-text);
	}

	/* Pinned note — a surface panel with a single warm accent, not a
	   saturated sticky pad. */
	.note {
		position: relative;
		align-self: start;
		background-color: var(--color-surface);
		border: 1px solid var(--color-highlight-low);
		border-radius: var(--radius-card);
		padding: var(--spacing-card-gutter);
		overflow: clip;
	}

	.note__doodle {
		inset-block-start: -1.25rem;
		inset-inline-end: -0.75rem;
		opacity: 0.4;
	}

	.note__list {
		display: grid;
		gap: 0.625rem;
		margin-block: 1rem 0;
		padding: 0;
	}

	.note__item {
		display: flex;
		align-items: baseline;
		gap: 0.625rem;
		font-family: var(--font-mono);
		font-size: 0.875rem;
		color: var(--color-text);
	}

	.note__bullet {
		flex: none;
		inline-size: 0.375rem;
		block-size: 0.375rem;
		border-radius: var(--radius-pill);
		background-color: var(--color-gold);
		translate: 0 -0.125rem;
	}

	.areas {
		display: grid;
		gap: 1rem;
		padding: 0;
	}

	.areas__item {
		position: relative;
		overflow: clip;
	}

	.areas__rule {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		inline-size: 3px;
		opacity: 0.85;
	}

	.areas__title {
		font-size: 1.125rem;
		margin-block-end: 0.5rem;
	}

	.areas__body {
		color: var(--color-subtle);
		font-size: 0.9375rem;
	}

	@media (min-width: 40rem) {
		.areas {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.about {
			grid-template-columns: 1.4fr 1fr;
			gap: 3rem;
			align-items: start;
		}

		.areas {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
