---
import { Mail } from "@lucide/svelte";
import Doodles from "./Doodles.astro";
import Marks from "./Marks.astro";
import { SITE } from "../data/site";
---

<section id="contact" class="section">
	<div class="shell">
		<div class="wrap">
			<div class="wrap__art" aria-hidden="true">
				<div class="wrap__doodle wrap__doodle--a">
					<Doodles name="loop" accent="rose" size={200} rotate={-12} />
				</div>
				<div class="wrap__doodle wrap__doodle--b">
					<Doodles name="cross" accent="foam" size={58} rotate={8} />
				</div>
			</div>

			<p class="eyebrow">Contact</p>
			<h2 class="section__title">Get in touch</h2>
			<p class="wrap__lede">
				Open to internships and junior SRE, DevOps or cloud roles. The fastest
				way to reach me is email; I'm happy to talk about anything I've broken.
			</p>

			<ul class="links" role="list">
				<li>
					<a class="panel contact" href={`mailto:${SITE.links.email}`}>
						<span class="contact__icon" aria-hidden="true"><Mail size={18} strokeWidth={1.75} /></span>
						<span class="contact__body">
							<span class="contact__label">Email</span>
							<span class="contact__value">{SITE.links.email}</span>
						</span>
					</a>
				</li>
				<li>
					<a
						class="panel contact"
						href={SITE.links.codebergUrl}
						target="_blank"
						rel="noopener noreferrer">
						<span class="contact__icon" aria-hidden="true"><Marks name="codeberg" size={18} /></span>
						<span class="contact__body">
							<span class="contact__label">Codeberg · primary</span>
							<span class="contact__value">{SITE.links.codeberg}</span>
						</span>
					</a>
				</li>
				<li>
					<a
						class="panel contact"
						href={SITE.links.linkedinUrl}
						target="_blank"
						rel="noopener noreferrer">
						<span class="contact__icon" aria-hidden="true"><Marks name="linkedin" size={18} /></span>
						<span class="contact__body">
							<span class="contact__label">LinkedIn</span>
							<span class="contact__value">{SITE.links.linkedin}</span>
						</span>
					</a>
				</li>
			</ul>

			<ul class="minor" role="list">
				<li><a href={SITE.links.mastodonUrl} rel="me noopener noreferrer" target="_blank">Mastodon</a></li>
				<li><a href={SITE.links.githubUrl} target="_blank" rel="noopener noreferrer">GitHub (mirror)</a></li>
				<li><a href={SITE.links.blog} target="_blank" rel="noopener noreferrer">Blog</a></li>
				<li><span>Discord {SITE.links.discord}</span></li>
			</ul>
		</div>
	</div>
</section>

<style>
	.wrap {
		position: relative;
		overflow: clip;
	}

	.wrap__art {
		position: absolute;
		inset: 0;
		pointer-events: none;
		z-index: 0;
	}

	.wrap__doodle {
		position: absolute;
		line-height: 0;
	}

	.wrap__doodle--a {
		position: absolute;
		inset-block-start: -2rem;
		inset-inline-end: -2rem;
		opacity: 0.4;
	}

	.wrap__doodle--b {
		position: absolute;
		inset-block-end: 0.25rem;
		inset-inline-end: 1.5rem;
		opacity: 0.3;
	}

	.wrap > *:not(.wrap__art) {
		position: relative;
		z-index: 1;
	}

	.wrap__lede {
		max-inline-size: 52ch;
		color: var(--color-subtle);
		margin-block-start: 1rem;
	}

	.links {
		display: grid;
		gap: 0.75rem;
		padding: 0;
		margin-block: 2.5rem 2rem;
	}

	.contact {
		display: flex;
		align-items: center;
		gap: 1rem;
		text-decoration: none;
		color: var(--color-text);
		min-block-size: 3.5rem;
	}

	.contact__icon {
		display: grid;
		place-items: center;
		inline-size: 2.5rem;
		block-size: 2.5rem;
		flex: none;
		border-radius: var(--radius-pill);
		background-color: var(--color-overlay);
		color: var(--color-love-ink);
	}

	.contact__body {
		display: grid;
		gap: 0.125rem;
		min-inline-size: 0;
	}

	.contact__label {
		font-family: var(--font-mono);
		font-size: 0.75rem;
		letter-spacing: 0.06em;
		text-transform: uppercase;
		color: var(--color-muted);
	}

	.contact__value {
		font-size: 0.9375rem;
		overflow-wrap: anywhere;
	}

	.minor {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem 1.25rem;
		padding: 0;
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		color: var(--color-muted);
	}

	.minor a {
		color: inherit;
		text-decoration: none;
	}

	.minor a:hover {
		color: var(--color-love-ink);
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (min-width: 40rem) {
		.links {
			grid-template-columns: repeat(3, 1fr);
		}
	}
</style>
