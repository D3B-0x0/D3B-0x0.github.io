---
import { ArrowUpRight } from "@lucide/svelte";
import { PROJECTS } from "../data/site";
---

<section id="projects" class="section">
	<div class="shell">
		<p class="eyebrow">The work</p>
		<h2 class="section__title">Problems, not products</h2>
		<p class="section__lede">
			Nobody hires a list of software. These are the problems I ran into owning
			infrastructure, and what I did about them.
		</p>

		<ul class="grid" role="list">
			{
				PROJECTS.map((project, i) => (
					<li
						class:list={[
							"panel",
							"card",
							"animate-enter",
							i === 0 && "card--lead",
						]}
						style={`--stagger: ${i % 3}`}
					>
						<span
							class="card__rule"
							style={`background-color: var(--color-${project.accent})`}
							aria-hidden="true"
						/>

						<p class="card__problem">{project.problem}</p>
						<h3 class="card__title">{project.title}</h3>
						<p class="card__body">{project.description}</p>

						<ul class="card__chips" role="list">
							{project.tech.map((tech) => (
								<li>
									<span
										class="chip"
										style={`--chip-accent: var(--color-${project.accent})`}
									>
										{tech}
									</span>
								</li>
							))}
						</ul>

						{project.link && (
							<a
								class="card__link"
								href={project.link}
								target="_blank"
								rel="noopener noreferrer"
								aria-label={project.linkLabel ?? `Open ${project.title}`}
							>
								View
								<ArrowUpRight size={15} strokeWidth={2} aria-hidden="true" />
							</a>
						)}
					</li>
				))
			}
		</ul>
	</div>
</section>

<style>
	.grid {
		display: grid;
		gap: 1rem;
		padding: 0;
		margin-block-start: 2.5rem;
	}

	.card {
		position: relative;
		display: flex;
		flex-direction: column;
		overflow: clip;
	}

	.card__rule {
		position: absolute;
		inset-block: 0;
		inset-inline-start: 0;
		inline-size: 3px;
		opacity: 0.85;
	}

	/* The problem, stated plainly, in mono — the reason the card exists. */
	.card__problem {
		font-family: var(--font-mono);
		font-size: 0.8125rem;
		line-height: 1.55;
		color: var(--color-muted);
		margin-block-end: 0.75rem;
	}

	.card__title {
		font-size: 1.25rem;
		margin-block-end: 0.625rem;
	}

	.card__body {
		color: var(--color-subtle);
		font-size: 0.9375rem;
		flex: 1;
	}

	.card__chips {
		display: flex;
		flex-wrap: wrap;
		gap: 0.375rem;
		padding: 0;
		margin-block: 1.25rem 0;
	}

	.card__link {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		align-self: flex-start;
		min-block-size: 2.75rem;
		margin-block-start: 0.5rem;
		color: var(--color-love-ink);
		font-family: var(--font-mono);
		font-size: 0.875rem;
		font-weight: 500;
		text-decoration: none;
	}

	.card__link:hover {
		text-decoration: underline;
		text-underline-offset: 3px;
	}

	@media (min-width: 40rem) {
		.grid {
			grid-template-columns: repeat(2, 1fr);
		}
	}

	@media (min-width: 64rem) {
		.grid {
			grid-template-columns: repeat(3, 1fr);
		}

		/* Break the even grid: the flagship problem gets double width, so the
		   board reads as a layout rather than a template. */
		.card--lead {
			grid-column: span 2;
		}

		.card--lead .card__title {
			font-size: 1.625rem;
		}

		.card--lead .card__body {
			font-size: 1rem;
			max-inline-size: 62ch;
		}
	}
</style>
