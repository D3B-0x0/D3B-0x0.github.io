# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Build outputs
dist/
build/
*.tsbuildinfo

# Astro generated types
.astro/

# Environment variables
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Logs
logs/
*.log

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage directory used by tools like istanbul
coverage/
*.lcov

# Temporary folders
tmp/
temp/

# Cache
.cache/
.parcel-cache/

# Optional npm cache directory
.npm

# Optional eslint cache
.eslintcache

# Vite
.vite/

# Cloudflare / TLS tooling state
# .wrangler/ holds local deploy state; wrangler's OAuth token lives in
# ~/.wrangler/config (outside the repo) but local state does not.
.wrangler/
.dev.vars
*.pem
*.key
*.p12
*.pfx
*.crt

# Terraform state (not used here yet, but never belongs in git)
*.tfstate
*.tfstate.*

# wrangler.toml is intentionally tracked; never blanket-ignore it
